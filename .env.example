# ══════════════════════════════════════════════════════════════
#  BandiBot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ── OpenAI ────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Deepgram ──────────────────────────────────────────────────
# API key from https://console.deepgram.com
# Used for both Speech-to-Text (Nova-3) and Text-to-Speech (Aura-2)
DEEPGRAM_API_KEY=

# ── YouTube / yt-dlp ─────────────────────────────────────────
# Optional JavaScript challenge solver runtime for yt-dlp EJS.
# Examples: node, deno, quickjs, or node:C:\path\to\node.exe
YOUTUBE_JS_RUNTIME=

# Optional EJS solver source. Example: ejs:github
YOUTUBE_REMOTE_COMPONENTS=

# ══════════════════════════════════════════════════════════════
#  BandiBot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ── OpenAI ────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Gemini Web Search ─────────────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
# Used for the web_search tool with Google Search Grounding.
GEMINI_API_KEY=

# ── Deepgram ──────────────────────────────────────────────────
# API key from https://console.deepgram.com
# Used for Speech-to-Text and optional Deepgram Text-to-Speech.
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=multi

# ── ElevenLabs TTS ────────────────────────────────────────────
# Required only when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── TTS Provider ──────────────────────────────────────────────
# Options: kokoro, deepgram, or elevenlabs
TTS_PROVIDER=kokoro
DEEPGRAM_TTS_MODEL=aura-2-javier-es
DEEPGRAM_TTS_SPEED=1.3
KOKORO_VOICE=ef_dora
KOKORO_LANG=e
KOKORO_SPEED=1.1

# ── Logging ──────────────────────────────────────────────────
# Normal logs use INFO; set to DEBUG for timing and RAG diagnostics.
LOG_LEVEL=INFO
# Set to 0 to keep message/response text out of logs.
LOG_SENSITIVE_CONTENT=1

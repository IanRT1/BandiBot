# ══════════════════════════════════════════════════════════════
#  BandiBot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ── OpenAI ────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini API key from https://aistudio.google.com/app/apikey
# Used for the web_search tool with Google Search Grounding.
GEMINI_API_KEY=

# Optional Gemini model for grounded web answers.
GEMINI_SEARCH_MODEL=gemini-3.8-flash

# ── Deepgram ──────────────────────────────────────────────────
# API key from https://console.deepgram.com
# Used for both Speech-to-Text (Nova-3) and Text-to-Speech (Aura-2)
DEEPGRAM_API_KEY=

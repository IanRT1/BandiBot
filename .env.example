# ══════════════════════════════════════════════════════════════
#  BandiBot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ── OpenAI ────────────────────────────────────────────────────
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Gemini Web Search ─────────────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
# Used for the web_search tool with Google Search Grounding.
# Optional: leave blank to omit web_search from the bot's available tools.
# Preflight checks presence only. Restart after adding or removing the key.
GEMINI_API_KEY=

# ── Deepgram ──────────────────────────────────────────────────
# API key from https://console.deepgram.com
# Used for Speech-to-Text and optional Deepgram Text-to-Speech.
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=multi

# ── TTS Provider ──────────────────────────────────────────────
# Options: kokoro, deepgram, or elevenlabs
TTS_PROVIDER=kokoro

#   Kokoro (TTS_PROVIDER=kokoro)
KOKORO_VOICE=ef_dora
KOKORO_LANG=e
KOKORO_SPEED=1.1

#   Deepgram (TTS_PROVIDER=deepgram)
# Uses DEEPGRAM_API_KEY from the Deepgram section above.
DEEPGRAM_TTS_MODEL=aura-2-javier-es
DEEPGRAM_TTS_SPEED=1.3

#   ElevenLabs (TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
